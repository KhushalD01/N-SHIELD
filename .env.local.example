# N-SHIELD Environment Configuration Example
# Copy this file to .env.local and configure your API keys.

# ==============================================================================
# Google Maps & Places Integration
# ==============================================================================
# Client-side Google Maps JavaScript API Key (Must be restricted by HTTP Referrer in Google Cloud Console)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_browser_key_here

# (Optional) Server-side Google Maps/Routes/Places API Key (Restricted by Server IP in Google Cloud Console)
GOOGLE_MAPS_SERVER_KEY=your_google_maps_server_key_here

# ==============================================================================
# AI Provider Integration (Optional)
# ==============================================================================
# Google Gemini API Key for dynamic natural language assistant processing
GEMINI_API_KEY=your_gemini_api_key_here

# ==============================================================================
# Real Nagpur Crime & Public Safety News Feeds
# ==============================================================================
# NewsAPI.org API Key (https://newsapi.org/)
NEWS_API_KEY=your_newsapi_org_key_here

# NewsData.io API Key (https://newsdata.io/)
NEWSDATA_API_KEY=your_newsdata_io_key_here

# ==============================================================================
# TinyFish Web Research & Browser Automation Integration (https://docs.tinyfish.ai/)
# ==============================================================================
# Server-side TinyFish API Key for real-time safety news, police reports, and web research
# NEVER expose to client-side code or prefix with NEXT_PUBLIC_
TINYFISH_API_KEY=your_tinyfish_api_key_here

# ==============================================================================
# Mapbox 3D Layers (Optional)
# ==============================================================================
# Mapbox Access Token (https://account.mapbox.com/access-tokens/)
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=pk.your_mapbox_token_here
