# Environment variables example for N-SHIELD
# Copy to .env.local and populate with your private keys

# TinyFish Web Research API Key (https://docs.tinyfish.ai/)
TINYFISH_API_KEY=your_tinyfish_api_key_here

# Google Gemini API Key for Assistant Reasoning
GEMINI_API_KEY=your_gemini_api_key_here

# Google Maps API Keys
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_browser_key_here
GOOGLE_MAPS_SERVER_KEY=your_google_maps_server_key_here

# News Providers
NEWS_API_KEY=your_newsapi_org_key_here
NEWSDATA_API_KEY=your_newsdata_io_key_here
